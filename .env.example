# API + dashboard
PORT=3000

# MongoDB 6.0+ (time-series collections)
MONGO_URI=mongodb://localhost:27017/heartbeat

# Prometheus server that scrapes node_exporter on your backend server
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_TIMEOUT_MS=800

# Which node_exporter targets to read. Must match prometheus.yml:
#   job_name -> NODE_EXPORTER_JOB
# NODE_EXPORTER_INSTANCE: leave EMPTY to collect every node in the job (a cluster — one record per
# node per minute). Set it to a single target address (10.0.0.12:9100) to follow one machine only.
NODE_EXPORTER_JOB=node
NODE_EXPORTER_INSTANCE=

# CPU is averaged over a window. Leave empty to use the heartbeat interval (recommended),
# so each record's CPU covers the same minute as its orders/chats.
# Must contain at least 2 Prometheus scrapes (a 1m window works with the usual 15s scrape).
CPU_RATE_WINDOW=

# Optional: override the generated PromQL completely
# CPU_QUERY=100 * (1 - avg(rate(node_cpu_seconds_total{job="node",mode="idle"}[5s])))
# MEMORY_PERCENT_QUERY=100 * (1 - node_memory_MemAvailable_bytes{job="node"} / node_memory_MemTotal_bytes{job="node"})

# Timezone used when grouping by day / week / month in the API and dashboard.
# 'UTC' or an IANA name such as Africa/Cairo. A "day" then means a local day.
REPORT_TIMEZONE=Africa/Cairo

# First day of the week for the 'week' grouping: monday | sunday | saturday
WEEK_START=monday

# Cron schedule for the collector. '* * * * *' = at the top of every minute.
# Examples: '*/5 * * * *' every 5 minutes, '*/10 * * * *' every 10 minutes.
HEARTBEAT_CRON=* * * * *

# How much time one record covers, in ms. Must match HEARTBEAT_CRON:
# '* * * * *' -> 60000, '*/5 * * * *' -> 300000
HEARTBEAT_INTERVAL_MS=60000

# How long records are kept
RETENTION_DAYS=30
